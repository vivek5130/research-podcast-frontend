# Where the FastAPI backend runs. Next.js proxies /api/* there (server-side only).
BACKEND_URL=http://localhost:3001

# Google OAuth client id (same as the backend's GOOGLE_CLIENT_ID).
# In Google Cloud Console, add http://localhost:3000 and your Vercel URL to "Authorized JavaScript origins".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Show the email-only dev sign-in (needs ALLOW_DEV_LOGIN=true on the backend). Keep false in production.
NEXT_PUBLIC_ALLOW_DEV_LOGIN=false
